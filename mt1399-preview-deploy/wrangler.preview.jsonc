{
  "name": "mt1399-road-analyzer-preview",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./dist/server/index.js",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mt1399-road-analyzer-preview-db",
      "database_id": "YOUR_PREVIEW_DB_ID_HERE"
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  }
}
